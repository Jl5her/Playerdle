# Sentry error monitoring (optional — disabled when empty)
# Create a React project at sentry.io → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
# Defaults to the Vite mode ("production" / "development") when unset
VITE_SENTRY_ENVIRONMENT=
# Fraction of page loads/navigations to trace, 0–1 (default 1 in dev, 0.1 in production)
VITE_SENTRY_TRACES_SAMPLE_RATE=
# Fraction of sessions to record with Session Replay, 0–1 (default 1 in dev, 0.1 in production).
# Sessions with an error are always recorded.
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=

# Sentry source map upload (build-time only — set in the CI / Cloudflare Pages build env,
# never commit the token). Upload is skipped when SENTRY_AUTH_TOKEN is unset.
# Create a token at sentry.io → Settings → Auth Tokens (Organization token)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
