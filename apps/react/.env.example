# PostHog game event analytics
# Create a project at posthog.com → copy the Project API Key
# Set person_profiles=never is already configured — no user identity is stored
VITE_POSTHOG_KEY=

# Sentry error monitoring (optional — disabled when empty)
# Create a React project at sentry.io → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
# Defaults to the Vite mode ("production" / "development") when unset
VITE_SENTRY_ENVIRONMENT=
